generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model AdminUser {
  passwordHash String @default("")
  sessions AdminSession[]
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("admin")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminSession {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  summary   String
  href      String?
  image     String?
  status    String   @default("draft")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TourPackage {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  subtitle   String
  category   String
  image      String?
  price      String
  duration   String
  audience   String
  route      String
  href       String?
  includes   String   @default("[]")
  itinerary  String   @default("[]")
  exclusions String   @default("[]")
  process    String   @default("[]")
  featured   Boolean  @default(false)
  status     String   @default("draft")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model VisaService {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  subtitle     String
  image        String?
  duration     String
  feeNote      String
  requirements String   @default("[]")
  process      String   @default("[]")
  status       String   @default("draft")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  category  String
  date      String
  image     String?
  sections  String   @default("[]")
  content   String?
  status    String   @default("draft")
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  location  String?
  rating    Int      @default(5)
  service   String
  feedback  String
  image     String?
  featured  Boolean  @default(false)
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  dailyWork LeadDailyWork[]
  uploads LeadUpload[]
  notes String @default("")
  reminders LeadReminder[]
  id               String   @id @default(cuid())
  name             String
  phone            String
  email            String?
  service          String
  message          String
  source           String   @default("website")
  preferredContact String   @default("phone")
  status           String   @default("new")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  owner            String   @default("Unassigned")
  form             String   @default("")
  labels           String   @default("")
  secondaryPhone   String   @default("")
  whatsapp         String   @default("")
  importedCreated  String   @default("")
  extraFields      String   @default("{}")
  importKey        String?  @unique
  conversations    LeadConversation[]
}

model LeadStage {
  id   String @id @default(cuid())
  name String @unique
  sortOrder Int @default(0)
}

model LeadPerson {
  id String @id @default(cuid())
  name String @unique
}

model LeadConversation {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  party String
  author String
  text String @default("")
  audio Bytes?
  audioType String?
  audioName String?
  createdAt DateTime @default(now())
  @@index([leadId, createdAt])
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimeType  String
  size      Int
  alt       String?
  category  String   @default("general")
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  message   String
  createdAt DateTime @default(now())
}

model MessageTemplate {
 id String @id @default(cuid())
 title String
 stage String @default("")
 text String
 status String @default("active")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model LeadReminder {
 id String @id @default(cuid())
 leadId String
 lead Lead @relation(fields:[leadId], references:[id], onDelete:Cascade)
 dueAt DateTime
 notes String @default("")
 status String @default("pending")
 author String
 completedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status,dueAt])
 @@index([leadId])
}

model LeadUpload {
  name String @default("")
  id Int @id @default(autoincrement())
  filename String
  author String
  createdAt DateTime @default(now())
  leads Lead[]
}

model LeadDailyWork {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  day String
  status String @default("not_checked")
  author String
  updatedAt DateTime @updatedAt
  @@unique([leadId,day])
  @@index([day,status])
}
